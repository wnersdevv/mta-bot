{
  "name": "gta-online-discord-bot",
  "version": "1.0.0",
  "description": "GTA V Online inspired, 4-language, TypeScript Discord economy/game platform",
  "main": "dist/wnersdev.js",
  "license": "MIT",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/wnersdev.js",
    "dev": "tsx watch wnersdev.ts",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "deploy:commands:global": "tsx src/deploy-commands.ts --global",
    "prisma:generate": "node scripts/run-with-config.js npx prisma generate",
    "prisma:push": "node scripts/run-with-config.js npx prisma db push",
    "prisma:studio": "node scripts/run-with-config.js npx prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "discord.js": "^14.16.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8",
    "canvas": "^2.11.2",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "prisma": "^5.19.1",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "tsc-alias": "^1.8.10",
    "vitest": "^2.0.5",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "prettier": "^3.3.3"
  }
}
